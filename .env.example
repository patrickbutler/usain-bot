# Garmin Connect credentials (never commit real values).
# The garminconnect library will cache a session token under
# GARMINTOKENS after the first successful login, so subsequent
# runs typically don't need to re-authenticate.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=change-me
GARMINTOKENS=~/.usain-bot/garmin_tokens

# Storage backend: "local" (default) or "gcp" (stubbed, not yet implemented).
USAIN_BOT_STORAGE_BACKEND=local

# Local backend paths (used when USAIN_BOT_STORAGE_BACKEND=local).
USAIN_BOT_DATA_DIR=./data

# GCP backend (stubbed placeholders — see storage/gcp.py).
# USAIN_BOT_GCP_PROJECT=
# USAIN_BOT_BQ_DATASET=
# USAIN_BOT_GCS_BUCKET=

# Chat (web UI only — everything else works without this).
# Provider is swappable: see chat/providers/. Only "anthropic" is
# implemented today; ANTHROPIC_API_KEY is required for the Chat tab.
ANTHROPIC_API_KEY=
# USAIN_BOT_CHAT_PROVIDER=anthropic
# USAIN_BOT_CHAT_MODEL=claude-sonnet-5
